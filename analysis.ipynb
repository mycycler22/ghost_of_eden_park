   "source": [
    "## Reading in data\n",
    "\n",
    "test_matches = pd.read_excel(\"detailed_test_matches.xlsx\") ## Description of match contexts and the final score of each match\n",
    "match_stats = pd.read_excel(\"aggregated_stats.xlsx\") ## Match stats collected using player data instead of team data\n",
    "test_nations = pd.read_excel(\"test_nations.xlsx\") ## List of all Tier 1 Test Nations\n",
    "team_stats = pd.read_excel(\"team_stats.xlsx\") ## Match stats by team\n",
    "venues = fetch_all_venues() ## All venues in the database"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "6a6180a4",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Only including test matches between Tier 1 Nations\n",
    "\n",
    "test_matches = test_matches[test_matches['home_team'].isin(test_nations['team_name']) &\n",
    "                            test_matches['away_team'].isin(test_nations['team_name'])]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "4b6e405c",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Removal of Fiji - no national stadium where they're the home team\n",
    "\n",
    "test_matches = test_matches[test_matches['home_team'] != \"Fiji\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "777171c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Data Cleaning\n",
    "\n",
    "## Only selecting the necessary variabled for outcome\n",
    "test_match_results = test_matches[['match_id', 'date', 'season', 'competition_id', 'competition', 'venue_id', 'venue', \n",
    "                                    'home_team', 'home_team_id', 'away_team', 'away_team_id', 'home_score', 'away_score']]\n",
    "\n",
    "## Creating a winner variable\n",
    "test_match_results['winner'] = np.where(test_match_results['home_score'] == test_match_results['away_score'],\n",
    "                                \"Draw\", np.where(test_match_results['home_score'] > test_match_results['away_score'], \n",
    "                                test_match_results['home_team'], test_match_results['away_team']))\n",
    "\n",
    "## Creating a new variable classify if the home team won or not\n",
    "test_match_results['home_team_win'] = np.where(test_match_results['winner'] == test_match_results['home_team'], 1, 0)\n",
    "\n",
    "## Designating all RWC matches as neutral matches outside of the matches that featured France (hosted the tournament)\n",
    "test_match_results['neutral_match'] = np.where((test_match_results['competition'] == \"Rugby World Cup\") &\n",
    "                                                (test_match_results['home_team'] != \"France\"),\n",
    "                                                \"neutral\", \"NA\")\n",
    "\n",
    "## test_match_results - information on all test matches including tests where there is no clear home team (neutral match)\n",
    "\n",
    "home_away_tests = test_match_results[test_match_results['neutral_match'] != \"neutral\"]\n",
    "\n",
    "## home_away_tests\n",
    "\n",
    "## home_away_tests - test matches where there is a clear home/away distinction. Ignores neutral-site \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "aa744c97",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Removal of New Zealand v. South Africa at Twickenham (neutral-site RWC Preparation Match)\n",
    "\n",
    "home_away_tests = home_away_tests[~home_away_tests['match_id'].isin(['db7135be'])]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "239278b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Only included venues that have hosted a test match\n",
    "\n",
    "test_venues = venues[venues['venue_id'].isin(test_match_results['venue_id'])]\n",
    "\n",
    "## Validation of the venues list; removed Wembley Stadium and Soldier Field\n",
    "\n",
    "test_venues = test_venues[~test_venues['venue_name'].isin(['Wembley Stadium', 'Soldier Field'])] "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "19e66cfb",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Only included match stats for Test 1 Teams\n",
    "\n",
    "match_stats = match_stats[match_stats['team'].isin(test_nations['team_name'])]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "27836848",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Data validation\n",
    "\n",
    "match_stats = match_stats.rename(columns = {\"team\": \"team_name\"})\n",
    "\n",
    "match_stats = match_stats[match_stats['turnovers_lost'] < 30] ## Some matches had teams who committed 100+ turnovers \n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "bd444fcf",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Merging test nations with their associated match stats\n",
    "\n",
    "match_stats = pd.merge(test_nations, match_stats, how = 'inner', on = 'team_name')\n",
    "\n",
    "## match_stats\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "6af110c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Joining data columns of stats not collected in the dataset using player data\n",
    "\n",
    "team_stats = team_stats[['team_id', 'team', 'game_date', 'team_vs', 'team_vs_id', 'match_id', '22m_entries', '22m_conversion',\n",
    "                        'post_contact_metres', 'ruck_speed_0_3_pct', 'ruck_speed_3_6_pct', 'ruck_speed_6_plus_pct',\n",
    "                        'possession', 'territory', 'scrums_total', 'mauls_total', 'rucks_total']] \n",
    "## All stats not collected using player data\n",
    "\n",
    "\n",
    "team_stats = team_stats.rename(columns={\"team\": \"team_name\"}) # renamed for the purpose of joining"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "e8f86e0f",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Join this with data collected from players data set\n",
    "\n",
    "potential_model_set = pd.merge(team_stats, match_stats, how=\"left\", on = ['team_id', 'team_name', 'match_id'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "6c57a144",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Home/Away Designation\n",
    "\n",
    "## Intended columns to drop; all associated with each team and associated score. game_date is a redundant column. \n",
    "\n",
    "drop_cols = ['team_name', 'team_vs', 'team_vs_id', 'game_date', 'score', 'team_vs_score']\n",
    "\n",
    "potential_model_set.drop(columns = [c for c in drop_cols if c in potential_model_set.columns])\n",
    "\n",
    "stat_cols = [c for c in potential_model_set.columns if c not in ('team_id', 'match_id')]\n",
    "\n",
    "## Creates a new data frame that adds the home designation for the statistics associated with the home team\n",
    "\n",
    "home_team_stats = potential_model_set.rename(columns={\n",
    "    'team_id': 'home_team_id',\n",
    "    **{c: f'home_{c}' for c in stat_cols}\n",
    "})\n",
    "\n",
    "## Creates a new data frame that adds the away designation for the statistics associated with the away team\n",
    "\n",
    "away_team_stats = potential_model_set.rename(columns={\n",
    "    'team_id': 'away_team_id',\n",
    "    **{c: f'away_{c}' for c in stat_cols}\n",
    "})\n",
    "\n",
    "## Joins both data sets\n",
    "\n",
    "potential_model_set = pd.merge(test_match_results, home_team_stats, on = ['match_id', 'home_team_id'], how = 'left')\n",
    "\n",
    "potential_model_set = potential_model_set.merge(away_team_stats, on = ['match_id', 'away_team_id'], how = 'left')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "97f840db",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Removing Neutral Matches\n",
    "\n",
    "potential_model_set = potential_model_set[potential_model_set['neutral_match'] != \"neutral\"]\n",
    "\n",
    "potential_model_set = potential_model_set.drop(columns=['neutral_match', 'home_game_date', 'away_game_date'])\n",
    "\n"
   ]
  },
  {
