    "train_pl = pl.from_pandas(train)\n",
    "test_pl = pl.from_pandas(test)\n",
    "\n",
    "\n",
    "mixed_log_regression = glmer(formula, data = train_pl, family = 'binomial')\n",
    "mixed_log_regression.fit(summary=True)\n",
    "\n"
