   "outputs": [],
   "source": [
    "## Elo Rating Development\n",
    "\n",
    "def expected_score(rating_a, rating_b):\n",
    "    return 1/(1 + 10 **((rating_b - rating_a)/400))\n",
    "\n",
    "def update_elo(rating, expected, actual, k = 20):\n",
    "    return rating + k * (actual - expected)\n",
    "\n",
    "def run_elo(matches, win_pct_seeds, initial_rating = 1000, k = 20):\n",
    "    matches = matches.sort_values('date').reset_index(drop = True)\n",
    "    seed_lookup = win_pct_seeds.set_index(['team_id', 'seed_season'])['elo_seed'].to_dict()\n",
    "    ratings = {}\n",
    "    records = []\n",
    "    current_season = None\n",
    "\n",
    "    for x, row in matches.iterrows():\n",
    "        home_id = row['home_team_id']\n",
    "        away_id = row['away_team_id']\n",
    "        season = row['season']\n",
    "\n",
    "        if season != current_season:\n",
    "            current_season = season\n",
    "        for id in ratings:\n",
    "            seed = seed_lookup.get((id, season), ratings[id])\n",
    "            ratings[id] = seed\n",
    "    \n",
    "        ratings.setdefault(home_id, seed_lookup.get((home_id, season), initial_rating))\n",
    "        ratings.setdefault(away_id, seed_lookup.get((away_id, season), initial_rating))\n",
    "\n",
    "        r_home = ratings[home_id]\n",
    "        r_away = ratings[away_id]\n",
    "\n",
    "        ratings.setdefault(home_id, )\n",
    "\n",
    "        p_home = expected_score(r_home, r_away)\n",
    "\n",
    "        if row['home_score'] > row['away_score']:\n",
    "            outcome = 1\n",
    "        elif row['home_score'] == row['away_score']:\n",
    "            outcome = 0.5\n",
    "        else:\n",
    "            outcome = 0\n",
    "        \n",
    "        records.append({\n",
    "            'match_id': row['match_id'],\n",
    "            'date': row['date'],\n",
    "            'home_team_id': home_id,\n",
    "            'away_team_id': away_id,\n",
    "            'pre_elo_home': r_home,\n",
    "            'pre_elo_away': r_away,\n",
    "            'elo_diff': r_home - r_away,\n",
    "            'predicted_prob': p_home,\n",
    "            'actual_outcome': outcome,\n",
    "            'wpa': outcome - p_home\n",
    "        })\n",
    "\n",
    "        ratings[home_id] = update_elo(r_home, p_home, outcome, k)\n",
    "        ratings[away_id] = update_elo(r_away, 1 - p_home, 1 - outcome, k)\n",
    "\n",
    "    results_df = pd.DataFrame(records)\n",
    "    final_ratings = pd.Series(ratings, name = 'elo')\n",
    "\n",
    "    return results_df, final_ratings\n",
    "\n",
    "def elo_from_win_pct(win_pct, base=1000, scale=200):\n",
    "    return base + scale * (win_pct - 0.5)\n",
    "\n"
   ]
  },
