   "source": [
    "## Using differences rather than raw numbers for both sides\n",
    "\n",
    "skip_cols = ['home_team', 'home_team_id', 'away_team', 'away_team_id', 'home_score',\n",
    "            'away_score', 'home_team_win']\n",
    "\n",
    "\n",
    "home_cols = [c for c in model_set.columns if c.startswith('home_') and c not in skip_cols]\n",
    "away_cols = [c for c in model_set.columns if c.startswith('away_') and c not in skip_cols]\n",
    "\n",
    "for col in home_cols + away_cols:\n",
    "    model_set[col] = pd.to_numeric(model_set[col], errors='coerce')\n",
    "\n",
    "for home_col in home_cols:\n",
    "    stat = home_col.replace('home_', '')\n",
    "    away_col = f'away_{stat}'\n",
    "    if away_col in model_set.columns:\n",
    "        model_set[f'{stat}_diff'] = model_set[home_col] - model_set[away_col]\n",
    "\n",
    "\n",
    "diff_cols = [c for c in model_set.columns if c.endswith('_diff')]\n",
    "print(model_set[diff_cols].head())\n",
    "print(model_set[diff_cols].notna().sum())\n",
    "\n"
   ]
