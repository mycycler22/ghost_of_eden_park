    "\n",
    "exclude = ['match_id', 'date', 'season', 'competition_id', 'competition',\n",
    "            'venue_id', 'venue', 'home_team_id', 'home_team', 'away_team_id',\n",
    "            'away_team', 'home_score', 'away_score', 'winner', 'home_team_win',\n",
    "            'pre_elo_home', 'pre_elo_away']\n",
    "\n",
    "features = [c for c in model_set if c not in exclude]\n",
    "\n",
    "corr = model_set[features].dropna().corr()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, 14))\n",
    "\n",
    "sns.heatmap(\n",
    "    corr,\n",
    "    cmap='coolwarm',\n",
    "    center=0,\n",
    "    vmin=-1, vmax=1,\n",
    "    annot=False,        # set True if you want numbers in cells (gets busy with 40 features)\n",
    "    square=True,\n",
    "    linewidths=0.3,\n",
    "    ax=ax\n",
    ")\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "af3ea649",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Dropped Column\n",
    "\n",
    "model_set = model_set.drop(columns='defenders_beaten_diff')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "c2391614",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "--- Fold 4 | Train: 90 | Test: 30 ---\n"
     ]
    }
   ],
   "source": [
    "## K-fold Cross Validation\n",
    "\n",
    "kf = KFold(n_splits = 4, shuffle = True, random_state=54)\n",
    "\n",
    "for fold, (train_idx, test_idx) in enumerate(kf.split(model_set)):\n",
    "    train = model_set.iloc[train_idx]\n",
    "    test = model_set.iloc[test_idx]\n",
    "\n",
    "print(f\"\\n--- Fold {fold+1} | Train: {len(train)} | Test: {len(test)} ---\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "c1cb5e25",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Split validation\n",
    "\n",
    "new_venues = set(test['venue']) - set(train['venue'])\n",
    "new_teams = (set(test['home_team']) | set(test['away_team'])) - \\\n",
    "            (set(train['home_team']) | set(train['away_team']))\n",
    "\n",
    "\n",
    "if new_venues:\n",
    "    test = test[~test['venue'].isin(new_venues)]\n",
    "\n",
    "if new_teams:\n",
    "    test = test[~test['home_team'].isin(new_teams) &\n",
    "                ~test['away_team'].isin(new_teams)]\n"
   ]
  },
