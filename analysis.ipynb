   "source": [
    "## Adding season form to elo rating\n",
    "\n",
    "test_matches['winner'] = np.where(test_matches['home_score'] == test_matches['away_score'],\n",
    "                                \"Draw\", np.where(test_matches['home_score'] > test_matches['away_score'], \n",
    "                                test_matches['home_team'], test_matches['away_team']))\n",
    "\n",
    "home_matches = test_matches[['season', 'home_team_id', 'home_team', 'home_score', 'away_score', 'winner']].copy()\n",
    "home_matches['team_id'] = home_matches['home_team_id']\n",
    "home_matches['team'] = home_matches['home_team']\n",
    "home_matches['win'] = np.where(home_matches['home_team'] == home_matches['winner'], 1, 0)\n",
    "\n",
    "away_matches = test_matches[['season', 'away_team_id', 'away_team', 'home_score', 'away_score', 'winner']].copy()\n",
    "away_matches['team_id'] = away_matches['away_team_id']\n",
    "away_matches['team'] = away_matches['away_team']\n",
    "away_matches['win'] = np.where(away_matches['away_team'] == away_matches['winner'], 1, 0)\n",
    "\n",
    "team_matches = pd.concat([\n",
    "    home_matches[['season', 'team_id', 'team', 'win']],\n",
    "    away_matches[['season', 'team_id', 'team', 'win']]\n",
    "], ignore_index = True)\n",
    "\n",
    "season_summary = (\n",
    "    team_matches\n",
    "    .groupby(['season', 'team_id', 'team'])\n",
    "    .agg(\n",
    "        games_played = ('team', 'size'),\n",
    "        wins = ('win', 'sum')\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "season_summary['win_pct'] = np.round((season_summary['wins']/season_summary['games_played']), 2)\n",
    "\n",
    "season_summary['seed_season'] = season_summary['season'] + 1\n",
    "season_summary['elo_seed'] = season_summary['win_pct'].apply(elo_from_win_pct)"
   ]
  },
